{
  "projectContext": ".claude/skills/PROJECT.md",
  "template": "test-cases/TEMPLATE.feature",
  "testCasesRoot": "test-cases/",
  "importRules": {
    "featureTags": false,
    "featureDescription": false,
    "background": false,
    "rule": false,
    "maxTitleLength": 200,
    "maxTagLength": 100
  },
  "tagRules": {
    "direction": [
      "@positive",
      "@negative"
    ],
    "checkType": [
      "@logic",
      "@navigation",
      "@ui",
      "@a11y"
    ],
    "gates": [
      "@not-implemented",
      "@blocked",
      "@manual",
      "@pending-oq"
    ],
    "platform": [
      "@ios-only",
      "@android-only"
    ],
    "area": [
      "@authentication",
      "@account",
      "@bookings",
      "@collections",
      "@explore",
      "@provider-listing"
    ],
    "titlePrefix": {
      "@positive": "Positive - ",
      "@negative": "Negative - "
    },
    "triage": {
      "blocked": [
        "@blocked",
        "@not-implemented"
      ],
      "manual": [
        "@ui",
        "@a11y",
        "@manual"
      ]
    }
  }
}
